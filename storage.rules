rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedInOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    // My Attendance cloud backup.
    // The Android app currently stores the latest backup at:
    // users/{uid}/backups/latest.json
    match /users/{userId}/backups/latest.json {
      allow read, delete: if signedInOwner(userId);

      allow create, update: if signedInOwner(userId)
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType == 'application/json';
    }

    // Reserved for user-owned documents if/when document cloud sync is enabled.
    match /users/{userId}/documents/{filePath=**} {
      allow read, delete: if signedInOwner(userId);

      allow create, update: if signedInOwner(userId)
        && request.resource.size <= 25 * 1024 * 1024;
    }

    // Reserved for user-owned profile images if/when profile photo cloud sync is enabled.
    match /users/{userId}/profile/{filePath=**} {
      allow read, delete: if signedInOwner(userId);

      allow create, update: if signedInOwner(userId)
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
