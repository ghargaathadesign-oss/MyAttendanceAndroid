rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedInOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    // My Attendance cloud backup.
    // The Android app currently stores the latest backup at:
    // users/{uid}/backups/latest.json
    match /users/{userId}/backups/latest.json {
      allow read, delete: if signedInOwner(userId);

      allow create, update: if signedInOwner(userId)
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType == 'application/json';
    }

    // Reserved for user-owned documents if/when document cloud sync is enabled.
    match /users/{userId}/documents/{filePath=**} {
      allow read, delete: if signedInOwner(userId);

      allow create, update: if signedInOwner(userId)
        && request.resource.size <= 25 * 1024 * 1024;
    }

    // Reserved for user-owned profile images if/when profile photo cloud sync is enabled.
    match /users/{userId}/profile/{filePath=**} {
      allow read, delete: if signedInOwner(userId);

      allow create, update: if signedInOwner(userId)
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function supportOwner() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email == 'pratik.kumar.kashyap@gmail.com';
    }
    function conversationAccess(threadUid) {
      return signedInOwner(threadUid) || supportOwner();
    }
    match /support/{path=**} {
      allow list: if supportOwner();
    }
    match /support/{threadUid}/{path=**} {
      allow get, list, delete: if conversationAccess(threadUid);
    }
    match /support/{threadUid}/profile.json {
      allow create, update: if signedInOwner(threadUid)
        && request.resource.size <= 4096
        && request.resource.contentType == 'application/json';
    }
    match /support/{threadUid}/messages/{senderUid}/{messageId} {
      allow create: if resource == null && conversationAccess(threadUid)
        && request.auth.uid == senderUid
        && request.resource.size <= 8192
        && request.resource.contentType == 'application/json'
        && request.resource.metadata.senderUid == request.auth.uid
        && request.resource.metadata.support == (supportOwner() ? 'true' : 'false');
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
